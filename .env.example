# ==============================================================================
# e-SUS APS PEC em Docker (Linux) - Configurações de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações de Rede e Portas
# ------------------------------------------------------------------------------
# IP local da interface de rede (ex: 127.0.0.1 para testes locais ou 192.168.x.x em LAN)
LAN_IP=127.0.0.1

# Portas da Aplicação e-SUS PEC
PEC_HTTP_PORT=8080
PEC_HTTPS_PORT=443

# Porta do Banco de Dados PostgreSQL (Exposta para auditoria/DW/BI)
POSTGRES_EXTERNAL_PORT=5433

# ------------------------------------------------------------------------------
# 2. Configurações do Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
# Nome do banco principal do e-SUS PEC
POSTGRES_DB=esus

# Usuário principal (DBA interno do PEC)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_essa_senha_super_secreta_aqui_123

# Usuário somente leitura para auditorias, BI e integração (LGPD)
ESUS_LEITURA_USER=esus_leitura
ESUS_LEITURA_PASSWORD=altere_essa_senha_de_leitura_aqui_456

# ------------------------------------------------------------------------------
# 3. Runtime Java / e-SUS PEC
# ------------------------------------------------------------------------------
# Limite de memória Heap da JVM (Ex: 4096M para UBSs menores, 8192M para servidores municipais)
PEC_HEAP=4096M

# Modo SSL:
# 0 = HTTP direto na porta 8080 (ambiente de teste/homologação ou proxy reverso)
# 1 = HTTPS na porta 443 com renovação automática via certmgr.jar
PEC_SSL=0

# Fuso horário oficial
TZ=America/Sao_Paulo

# ------------------------------------------------------------------------------
# 4. Versão e Origem do Pacote e-SUS PEC
# ------------------------------------------------------------------------------
# Nome do arquivo instalador baixado ou URL direta do SISAPS
# Se deixado em branco, os scripts de build podem baixar a última release disponível.
PEC_JAR_FILE=eSUS-AB-PEC-5.5.28-Linux64.jar
