# ==============================================================================
# e-SUS APS PEC em Docker (Linux) - Variáveis de ambiente
# ==============================================================================
# Não copie este arquivo à mão: rode ./scripts/gerar-env.sh, que cria o .env
# com senhas aleatórias e permissão 600.
# Para trocar senhas de uma instalação que já tem banco: ./scripts/trocar-senhas.sh
# (editar o .env não muda a senha que está gravada dentro do PostgreSQL).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rede e portas
# ------------------------------------------------------------------------------
# IP em que o PEC é publicado: 127.0.0.1 (só local / atrás de proxy)
# ou o IP do servidor na LAN (ex.: 192.168.251.20) para as UBS acessarem.
PEC_BIND_IP=127.0.0.1
PEC_HTTP_PORT=8080
PEC_HTTPS_PORT=443

# IP em que o PostgreSQL é publicado. Deixe 127.0.0.1: acesso de BI pela rede
# deve passar por VPN/túnel SSH ou por regra na chain DOCKER-USER do iptables.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_EXTERNAL_PORT=5433

# Sub-rede interna dos containers (troque só se colidir com alguma rede sua)
ESUS_NET_SUBNET=198.18.200.0/24

# ------------------------------------------------------------------------------
# 2. Banco de dados
# ------------------------------------------------------------------------------
POSTGRES_DB=esus
# Usuário dono do banco, usado pelo PEC e pelo migrador
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_gere_com_scripts_gerar_env

# Usuário somente leitura para BI, auditoria e integrações (máx. 5 conexões)
ESUS_LEITURA_USER=esus_leitura
ESUS_LEITURA_PASSWORD=altere_gere_com_scripts_gerar_env

# Memória do PostgreSQL (servidor de 16 GB: 2GB / 6GB; de 8 GB: 1GB / 3GB)
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_CONNECTIONS=200

# ------------------------------------------------------------------------------
# 3. PEC (Java)
# ------------------------------------------------------------------------------
# Heap máximo da JVM (4096M até ~40 usuários simultâneos; 8192M acima disso)
PEC_HEAP=4096M
# Opções extras da JVM, separadas por espaço (opcional)
PEC_JAVA_OPTS_EXTRA=

# HTTPS com o certmgr oficial: use compose.ssl.yml e informe o domínio público
# (ex.: esus.municipio.pr.gov.br) com as portas 80 e 443 liberadas no roteador.
# Com HTTPS, PEC_BIND_IP precisa ser o IP que recebe o encaminhamento do roteador (ou 0.0.0.0)
# e os scripts precisam usar o compose.ssl.yml: descomente a linha COMPOSE_FILE.
PEC_SSL=0
PEC_SSL_DOMAIN=
PEC_SSL_PORT=443
#COMPOSE_FILE=compose.yml:compose.ssl.yml

TZ=America/Sao_Paulo

# ------------------------------------------------------------------------------
# 4. Instalador oficial
# ------------------------------------------------------------------------------
# Arquivo dentro de instalador/ (./scripts/get-latest-pec.sh --download preenche estes três)
PEC_JAR_FILE=eSUS-AB-PEC-5.5.28-Linux64.jar
# SHA-256 do instalador; se preenchido, o build confere antes de extrair
PEC_JAR_SHA256=
PEC_IMAGE_TAG=5.5.28

# ------------------------------------------------------------------------------
# 5. Backup
# ------------------------------------------------------------------------------
# Pasta dos backups (padrão: ./backups) e dias de retenção
BACKUP_DIR=
RETENTION_DAYS=30
